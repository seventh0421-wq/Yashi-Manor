{
  "entities": {
    "Reservation": {
      "title": "Reservation",
      "description": "Guest dining reservation submitted by cafe patrons",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique reservation code (e.g. 20261018-01)",
          "maxLength": 64
        },
        "date": {
          "type": "string",
          "description": "Reservation date in YYYY-MM-DD or formatted string",
          "maxLength": 32
        },
        "timeSlot": {
          "type": "string",
          "description": "Dining time slot (e.g. 20:30 - 21:50)",
          "maxLength": 32
        },
        "staffName": {
          "type": "string",
          "description": "Designated maid or butler name",
          "maxLength": 64
        },
        "guestCount": {
          "type": "number",
          "description": "Number of guests"
        },
        "customerName": {
          "type": "string",
          "description": "Patron character name in FF14",
          "maxLength": 64
        },
        "worldServer": {
          "type": "string",
          "description": "FF14 World Server",
          "maxLength": 64
        },
        "contactMethod": {
          "type": "string",
          "description": "In-game tell / discord / contact method",
          "maxLength": 128
        },
        "selectedDishes": {
          "type": "array",
          "description": "Pre-ordered dish items with quantity and price"
        },
        "specialRequests": {
          "type": "string",
          "description": "Special request or notes from patron",
          "maxLength": 1000
        },
        "status": {
          "type": "string",
          "description": "Reservation status (pending, confirmed, completed, cancelled)",
          "enum": ["pending", "confirmed", "completed", "cancelled"]
        },
        "adminNotes": {
          "type": "string",
          "description": "Internal notes for maids & butlers",
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "description": "ISO timestamp of creation"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of last update"
        }
      },
      "required": ["id", "date", "timeSlot", "staffName", "guestCount", "customerName", "worldServer", "status", "createdAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator authorized to manage reservations and cafe operations",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Auth UID"
        },
        "email": {
          "type": "string",
          "description": "Admin email address"
        },
        "role": {
          "type": "string",
          "enum": ["admin", "staff"]
        },
        "displayName": {
          "type": "string",
          "maxLength": 64
        },
        "createdAt": {
          "type": "string"
        }
      },
      "required": ["uid", "email", "role"]
    },
    "GuestbookMessage": {
      "title": "GuestbookMessage",
      "description": "Public visitor guestbook message moderated by admins and created via trusted backend",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Firestore document ID",
          "maxLength": 64
        },
        "characterName": {
          "type": "string",
          "description": "Patron character name",
          "minLength": 2,
          "maxLength": 40
        },
        "server": {
          "type": "string",
          "description": "FF14 World Server",
          "minLength": 1,
          "maxLength": 32
        },
        "favoriteMaid": {
          "type": "string",
          "description": "Optional favorite maid or butler name",
          "maxLength": 40
        },
        "badge": {
          "type": "string",
          "description": "Selected sticker badge",
          "enum": ["✨", "☕", "🍰", "🌸", "🐾"]
        },
        "message": {
          "type": "string",
          "description": "Plain-text guestbook message",
          "minLength": 1,
          "maxLength": 300
        },
        "createdAt": {
          "type": "string",
          "description": "Server-generated ISO-8601 timestamp"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO-8601 timestamp of last admin moderation"
        },
        "status": {
          "type": "string",
          "description": "Visibility status controlled by backend and admins",
          "enum": ["published", "hidden"]
        },
        "sourceHash": {
          "type": "string",
          "description": "Internal HMAC hash of visitor IP (never exposed publicly)",
          "maxLength": 64
        },
        "moderatedBy": {
          "type": "string",
          "description": "Admin email or UID who last changed visibility",
          "maxLength": 128
        }
      },
      "required": ["id", "characterName", "server", "badge", "message", "createdAt", "status"]
    },
    "GuestbookRateLimit": {
      "title": "GuestbookRateLimit",
      "description": "Persistent cross-instance rate-limiting & deduplication tracking keyed by hashed source IP",
      "type": "object",
      "properties": {
        "lastSuccessAt": {
          "type": "number",
          "description": "Epoch ms of last successful guestbook post"
        },
        "hourlyTimestamps": {
          "type": "array",
          "description": "Recent post epoch timestamps within the last 1 hour"
        },
        "lastContentHash": {
          "type": "string",
          "description": "Hash of the last submitted message content",
          "maxLength": 64
        },
        "lastContentAt": {
          "type": "number",
          "description": "Epoch ms of last content hash"
        },
        "lastRequestId": {
          "type": "string",
          "description": "Last idempotency requestId",
          "maxLength": 64
        },
        "updatedAt": {
          "type": "number",
          "description": "Epoch ms of last update"
        }
      },
      "required": ["lastSuccessAt", "hourlyTimestamps", "updatedAt"]
    },
    "ReservationRequest": {
      "title": "ReservationRequest",
      "description": "Server-only idempotency and lease-locking record keyed by client requestId",
      "type": "object",
      "properties": {
        "requestId": {
          "type": "string",
          "maxLength": 64
        },
        "status": {
          "type": "string",
          "enum": ["processing", "completed", "failed"]
        },
        "payloadHash": {
          "type": "string",
          "maxLength": 64
        },
        "processingToken": {
          "type": "string",
          "maxLength": 64
        },
        "processingExpiresAt": {
          "type": "number"
        },
        "bookingId": {
          "type": "string",
          "maxLength": 64
        },
        "attemptCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["requestId", "status", "payloadHash", "createdAt", "updatedAt"]
    },
    "ReservationCounter": {
      "title": "ReservationCounter",
      "description": "Server-only daily atomic sequence counter for YYYYMMDD-XXXX reservation codes",
      "type": "object",
      "properties": {
        "dateKey": {
          "type": "string",
          "maxLength": 8
        },
        "lastSeq": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": ["dateKey", "lastSeq", "updatedAt"]
    }
  },
  "firestore": {
    "/reservations/{reservationId}": {
      "schema": "Reservation",
      "description": "Stores guest dining reservations for the cafe"
    },
    "/reservationRequests/{requestId}": {
      "schema": "ReservationRequest",
      "description": "Server-only idempotency and lease locking for reservation creation"
    },
    "/reservationCounters/{dateKey}": {
      "schema": "ReservationCounter",
      "description": "Server-only daily atomic sequence counter for YYYYMMDD-XXXX reservation codes"
    },
    "/admins/{adminUid}": {
      "schema": "AdminUser",
      "description": "Authorized administrators list"
    },
    "/guestbookMessages/{messageId}": {
      "schema": "GuestbookMessage",
      "description": "Guestbook entries accessed strictly via backend APIs"
    },
    "/guestbookRateLimits/{sourceHash}": {
      "schema": "GuestbookRateLimit",
      "description": "Server-only rate limiting state for guestbook submissions"
    }
  }
}
